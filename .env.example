# Copy this file to .env.local and fill in real values. Never commit .env.local.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aether?retryWrites=true&w=majority
SESSION_SECRET=replace-with-48-random-characters
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace-with-the-secret-you-set-in-razorpay
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=at-least-12-characters
